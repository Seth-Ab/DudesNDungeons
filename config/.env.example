# Copy to .env at the repository root and adjust as needed. Never commit a real .env.

# Port the HTTP + WebSocket server listens on.
PORT=8080

# Interface to bind. Use 127.0.0.1 to restrict to this machine.
HOST=0.0.0.0

# Value for Access-Control-Allow-Origin on the HTTP routes. Defaults to any origin, which the
# split dev ports (client 5173, server 8080) require. Set an explicit origin to restrict it.
CORS_ORIGIN=*

# Client only, read by Vite at build time. Defaults to ws://localhost:8080. The HTTP origin used
# for POST /sessions is derived from this, so a single value configures both.
VITE_WS_URL=ws://localhost:8080

# Client only. Comma-separated STUN/TURN URLs for proximity voice. Unset uses
# stun:stun.l.google.com:19302; an empty value uses none, which is enough on one LAN.
# VITE_ICE_SERVERS=stun:stun.l.google.com:19302

# Where the server reads game content (monsters, items, room templates, dungeons) from. Defaults to
# content/ beside package.json, which is correct for both `npm run dev:server` and `npm start`.
# Set it only if a deployment ships content somewhere else.
CONTENT_DIR=

# Where the server keeps persistent state, currently player profiles in data/profiles.json.
# Defaults to data/ beside package.json. Point it at a mounted volume for a deployment whose disk
# is otherwise ephemeral: losing this file loses every player's banked items and unlocks.
DATA_DIR=

# Server only. A simulation tick that takes at least this many milliseconds is logged, at most once
# every five seconds. The tick budget is 50 ms; defaults to 25.
# SLOW_TICK_MS=25
